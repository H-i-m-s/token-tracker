{
  "schema": 1,

  "publisher": "H-i-m-s",
  "defaultBranch": "master",

  "release": {
    "repo": "H-i-m-s/token-tracker"
  },

  "pack": {
    "out": "dist",
    "excludeDirs": [".git", ".github", "node_modules", "dist", "release", "scripts", "test", "doc"],
    "excludeNames": [".DS_Store", "Thumbs.db", "desktop.ini"],
    "excludePrefixes": ["._"],
    "excludeExtensions": ["tmp", "temp", "swp", "swo", "log", "bak"],
    "excludeSuffixes": ["~"],
    "selfcheck": "required"
  }
}
