{
  "manifestVersion": 2,
  "id": "token-tracker-app",
  "name": "Token 用量",
  "description": "本机 Token 用量看板：把会话与账本扫成可筛可导的用量记录，按时间、模型、Agent 看用量与花费；余额额度一并查，附五种分析图表与实时速度。数据不出本机，自带历史归档，无需配套插件。",
  "version": "8.6.0",
  "minAppVersion": "0.1050.9",
  "entry": "index.js",
  "capabilities": [
    "app/runtime.execute",
    "app/runtime.local-machine",
    "app/runtime.network",
    "app/usage.read",
    "app/sessions.read",
    "app/input.status",
    "app/ui.open-external",
    "app/hooks.provider-before-request",
    "app/hooks.observe"
  ],
  "network": {
    "allowedHosts": ["github.com"],
    "methods": ["GET"],
    "defaultTimeoutMs": 15000,
    "maxResponseBytes": 2097152
  },
  "contributes": {
    "settings": {
      "title": "Token 用量",
      "ui": {
        "route": "/settings.html"
      }
    },
    "ui": {
      "inputStatus": [
        {
          "id": "session-cache",
          "title": "本会话缓存与生成速度",
          "text": "缓存：—　速度：—"
        }
      ]
    },
    "cards": [
      {
        "id": "workspace",
        "title": "Token 用量",
        "description": "Agent Token、余额和实时消耗工作台",
        "route": "/workspace.html",
        "realization": "page",
        "siteNavEntry": false,
        "functionPanel": {
          "id": "navigation",
          "label": "Token 用量",
          "route": "/navigation.html"
        },
        "fpFullPanel": true,
        "closable": false,
        "detached": {
          "route": "/standalone.html"
        },
        "cardForm": "flush",
        "titlebar": "translucent",
        "face": {
          "image": "assets/token-tracker-cover.svg"
        }
      },
      {
        "id": "multi",
        "title": "Token 多功能卡",
        "description": "一张卡切换用量、余额、明细、实时监控与五种分析图表；三点菜单勾选要显示哪些选项卡，页签多了可横向滚动。",
        "route": "/card.html",
        "realization": "card",
        "cardForm": "flush",
        "titlebar": "solid",
        "detached": {
          "route": "/card.html"
        },
        "detachedDefaultSize": {
          "width": 520,
          "height": 680
        },
        "face": {
          "image": "assets/token-card-cover.svg"
        }
      }
    ]
  },
  "icon": "assets/icon.svg"
}
